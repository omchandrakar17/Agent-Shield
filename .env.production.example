# AgentShield production environment (Cloud Run + Firebase Hosting)
# Copy values into Secret Manager — do not commit real secrets.

AGENTSHIELD_ENV=production
AGENTSHIELD_AUTH_MODE=local
AGENTSHIELD_SEED_USERS=false
AGENTSHIELD_RUN_MIGRATIONS=true
AGENTSHIELD_USE_SECRET_MANAGER=true
AGENTSHIELD_USE_PUBSUB=true
AGENTSHIELD_USE_FIRESTORE=true
AGENTSHIELD_USE_BIGQUERY=true

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
CLOUD_SQL_CONNECTION_NAME=your-gcp-project-id:us-central1:agentshield-db

AGENTSHIELD_PUBSUB_TOPIC=agentshield-events
AGENTSHIELD_PUBSUB_AUDIT_TOPIC=agentshield-audit-events
AGENTSHIELD_BIGQUERY_DATASET=agentshield

# Stored in Secret Manager (see infra/scripts/setup-gcp.sh)
# AGENTSHIELD_JWT_SECRET=
# AGENTSHIELD_AGENT_API_KEY=
# AGENTSHIELD_INTERNAL_SERVICE_KEY=
# AGENTSHIELD_DATABASE_URL=postgresql+pg8000://...
# AGENTSHIELD_CORS_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com
# GEMINI_API_KEY=

AGENTSHIELD_AGENT_PLANNER=vertex
VERTEX_GEMINI_MODEL=gemini-2.0-flash-001

# Frontend build (Firebase Hosting — relative API via rewrites)
VITE_API_URL=/api/v1
